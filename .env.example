NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://your-domain.example
# Website origin checked by the public status page.
PUBLIC_STATUS_SITE_URL=https://makeitso.studio/
TRUST_PROXY=1
DATABASE_URL=
APP_SECRET=
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Optional verified sender address; defaults to SMTP_USER.
SMTP_FROM=
# Contact form notifications are sent here; defaults to SMTP_USER.
CONTACT_EMAIL=hello@makeitso.studio
# Optional overrides for private media checks. Empty disables a service.
MEDIA_JELLYFIN_URL=https://jellyfin.makeitso.studio/
MEDIA_JELLYSEERR_URL=https://seer.makeitso.studio/
# TCP reachability only; no remote-desktop login or OS health inspection.
MEDIA_UBUNTU_TCP=213.119.105.234:3389
